<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ログイン｜食事宿泊報告ツール</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <span class="title">食事宿泊報告ツール</span>
    <nav><a href="/admin/login">管理者はこちら</a></nav>
  </header>

  <div class="container">
    <div class="card" style="max-width:420px; margin:0 auto;">
      <h1>ホームログイン</h1>
      <p class="muted">担当しているホームを選び、パスワードを入力してください。</p>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <form method="POST" action="/login">
        <label for="home_id">ホーム</label>
        <select name="home_id" id="home_id" required>
          <option value="">-- 選択してください --</option>
          <% homes.forEach(function(h) { %>
            <option value="<%= h.id %>"><%= h.name %></option>
          <% }) %>
        </select>

        <label for="password">パスワード</label>
        <input type="password" name="password" id="password" required />

        <button type="submit">ログイン</button>
      </form>
    </div>
  </div>
</body>
</html>
