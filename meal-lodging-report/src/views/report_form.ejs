<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= homeName %>｜食事宿泊報告ツール</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <span class="title">食事宿泊報告ツール - <%= homeName %></span>
    <nav><a href="/logout">ログアウト</a></nav>
  </header>

  <div class="container">
    <div class="card">
      <h1>報告を入力</h1>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <form method="GET" action="/report" class="filter-bar">
        <div>
          <label for="report_date">日付</label>
          <input type="date" name="report_date" id="report_date" value="<%= reportDate %>" required />
        </div>
        <div>
          <label for="reporter_name">報告者</label>
          <input type="text" name="reporter_name" id="reporter_name" value="<%= reporterName %>" required placeholder="あなたの名前" />
        </div>
        <div>
          <button type="submit">この内容で入力する</button>
        </div>
      </form>

      <% if (users.length > 0) { %>
      <p class="muted">利用者タブを選んで、〇×をチェックして「登録する」を押してください。同じ日に登録し直すと上書きされます。</p>

      <div class="tab-buttons">
        <% users.forEach(function(u) { %>
          <button type="button" class="tab-btn" data-tab="user-<%= u.id %>"><%= u.name %></button>
        <% }) %>
      </div>

      <% users.forEach(function(u) {
           const existing = reportsByUser[u.id];
      %>
        <div class="tab-panel" id="user-<%= u.id %>">
          <form method="POST" action="/report">
            <input type="hidden" name="report_date" value="<%= reportDate %>" />
            <input type="hidden" name="reporter_name" value="<%= reporterName %>" />
            <input type="hidden" name="home_user_id" value="<%= u.id %>" />

            <h2 style="margin-top:0;"><%= u.name %> さん（<%= reportDate %>）</h2>

            <div class="checkbox-row">
              <label><input type="checkbox" name="dinner" <%= (existing && existing.dinner) ? 'checked' : '' %> /> 夕食</label>
              <label><input type="checkbox" name="lodging" <%= (existing && existing.lodging) ? 'checked' : '' %> /> 宿泊</label>
              <label><input type="checkbox" name="breakfast" <%= (existing && existing.breakfast) ? 'checked' : '' %> /> 朝食</label>
            </div>

            <button type="submit">登録する</button>
          </form>
        </div>
      <% }) %>
      <% } %>
    </div>

    <div class="card">
      <h2>最近の報告（このホーム・最新100件）</h2>
      <table>
        <thead>
          <tr>
            <th>日付</th>
            <th>利用者名</th>
            <th>報告者</th>
            <th>夕食</th>
            <th>宿泊</th>
            <th>朝食</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% reports.forEach(function(r) { %>
            <tr>
              <td><%= r.report_date.toISOString().slice(0,10) %></td>
              <td><%= r.user_name %></td>
              <td><%= r.reporter_name %></td>
              <td class="<%= r.dinner ? 'mark-ok' : 'mark-ng' %>"><%= r.dinner ? '〇' : '×' %></td>
              <td class="<%= r.lodging ? 'mark-ok' : 'mark-ng' %>"><%= r.lodging ? '〇' : '×' %></td>
              <td class="<%= r.breakfast ? 'mark-ok' : 'mark-ng' %>"><%= r.breakfast ? '〇' : '×' %></td>
              <td>
                <form class="inline" method="POST" action="/report/<%= r.id %>/delete" onsubmit="return confirm('この報告を削除しますか？');">
                  <button type="submit" class="danger" style="margin-top:0; padding:4px 10px; font-size:0.85rem;">削除</button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if (reports.length === 0) { %>
            <tr><td colspan="7" class="muted">まだ報告がありません</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    (function () {
      var buttons = document.querySelectorAll('.tab-btn');
      var panels = document.querySelectorAll('.tab-panel');

      function showTab(id) {
        panels.forEach(function (p) {
          p.style.display = (p.id === id) ? 'block' : 'none';
        });
        buttons.forEach(function (b) {
          b.classList.toggle('active', b.dataset.tab === id);
        });
      }

      buttons.forEach(function (b) {
        b.addEventListener('click', function () { showTab(b.dataset.tab); });
      });

      var params = new URLSearchParams(window.location.search);
      var initialTab = params.get('tab');
      if (initialTab && document.getElementById('user-' + initialTab)) {
        showTab('user-' + initialTab);
      } else if (buttons.length > 0) {
        showTab(buttons[0].dataset.tab);
      }
    })();
  </script>
</body>
</html>
