<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ホーム管理｜食事宿泊報告ツール</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <span class="title">ホーム管理</span>
    <nav>
      <a href="/admin">ダッシュボードへ戻る</a>
      <a href="/admin/logout">ログアウト</a>
    </nav>
  </header>

  <div class="container">
    <div class="card">
      <h1>ホームを新規追加</h1>
      <form method="POST" action="/admin/homes">
        <label for="name">ホーム名</label>
        <input type="text" name="name" id="name" required placeholder="例: ホームA" />

        <label for="password">初期パスワード</label>
        <input type="text" name="password" id="password" required placeholder="職員に伝えるパスワード" />

        <button type="submit">追加する</button>
      </form>
    </div>

    <div class="card">
      <h2>登録済みホーム一覧</h2>
      <table>
        <thead>
          <tr>
            <th>ホーム名</th>
            <th>登録日</th>
            <th>利用者管理</th>
            <th>パスワードリセット</th>
            <th>削除</th>
          </tr>
        </thead>
        <tbody>
          <% homes.forEach(function(h) { %>
            <tr>
              <td><%= h.name %></td>
              <td><%= h.created_at.toISOString().slice(0,10) %></td>
              <td><a href="/admin/homes/<%= h.id %>/users" class="btn" style="margin-top:0; padding:6px 12px; font-size:0.85rem;">利用者を管理</a></td>
              <td>
                <form class="inline" method="POST" action="/admin/homes/<%= h.id %>/reset-password">
                  <input type="text" name="password" placeholder="新しいパスワード" required style="width:160px; display:inline-block;" />
                  <button type="submit" style="margin-top:0;">更新</button>
                </form>
              </td>
              <td>
                <form class="inline" method="POST" action="/admin/homes/<%= h.id %>/delete" onsubmit="return confirm('「<%= h.name %>」を削除しますか？関連する報告データもすべて削除されます。');">
                  <button type="submit" class="danger" style="margin-top:0;">削除</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
